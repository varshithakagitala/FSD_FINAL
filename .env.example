# ======================================================================
# RescueGrid - MongoDB Atlas, JWT & Gmail SMTP Environment Configuration
# ======================================================================

# Port for the Node.js / Express backend server
PORT=3000

# MongoDB Atlas Database Connection URI (leave blank to use local in-memory MongoDB)
# Obtain from MongoDB Atlas -> Database -> Connect -> Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster-address>/rescuegrid?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/rescuegrid?retryWrites=true&w=majority

# Cryptographically Secure JSON Web Token Secret
# Generate locally using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret

# Gmail SMTP Email Configuration (Nodemailer)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Set your Gmail address and App Password locally; never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Client Origin (CORS & Base URL)
CLIENT_URL=http://localhost:3000
